rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Student progress — authenticated users can read/write their own data
    match /progress/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared timelines — any authenticated user can read/write
    // (admin edits are shared per-program, last editor wins)
    match /timelines/{programId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Per-user edit history
      match /edits/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
